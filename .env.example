# COA Effect-Spectrum Profiler — configuration template.
# All values are non-secret at the default configuration. Copy to .env.

MAX_UPLOAD_MB=15
# Expansion limits protect OCR memory from highly compressed or oversized
# documents. Defaults allow ordinary multi-page COAs with generous headroom.
MAX_PDF_PAGES=20
MAX_PDF_PAGE_PIXELS=8000000
MAX_PDF_TOTAL_PIXELS=48000000
MAX_IMAGE_PIXELS=12000000
MAX_IMAGE_DIMENSION=8000
# Per-page deadline for both Poppler rendering and Tesseract OCR. Must stay
# below the 110-second whole-upload deadline.
OCR_TIMEOUT_SECONDS=30
SESSION_TTL_SECONDS=300
# Secure flag on the session cookie; set to false for HTTP development only.
SESSION_COOKIE_SECURE=true
RATE_LIMIT_PER_MINUTE=20
FEEDBACK_RATE_LIMIT_PER_MINUTE=10
PORT=8080

# Optional public contact address. Leave empty to hide contact links.
CONTACT_EMAIL=

# Optional inference-assist fallback (DIS-2). DISABLED by default; the
# deterministic parser is the sole active path at launch. Determinism
# (FR-022) and the no-data-transfer walk-away condition are guaranteed only
# while this is false.
INFERENCE_ASSIST_ENABLED=false
INFERENCE_ASSIST_URL=
# Optional credential for the inference endpoint; never logged.
INFERENCE_ASSIST_API_KEY=

# Gunicorn/Uvicorn may honor X-Forwarded-* only from these proxy peers.
# docker-compose defaults this to * because its published socket is bound to
# 127.0.0.1 and Nginx's Docker-bridge address varies by platform. If the app
# port is exposed any other way, replace * with the exact proxy IP/CIDR first.
FORWARDED_ALLOW_IPS=*

# Normally leave this empty: trusted Uvicorn proxy handling above normalizes
# request.client from the X-Forwarded-For value that Nginx overwrites. This
# legacy escape hatch reads a raw header directly and therefore requires the
# same strict edge-header overwrite policy.
TRUSTED_PROXY_HEADER=

# Access-log IP handling: hashed (default, SHA-256 with daily salt) | full |
# truncated | disabled.
LOG_IP_RETENTION=hashed

PROCESSING_THREAD_POOL_SIZE=4

# Boot copy-lint is FATAL by default (walk-away gate 4). true = log a warning
# and start anyway (emergency operator use only; logged at startup).
COPYLINT_SOFT_FAIL=false

# HEIC support is on by default and the decoder is required at boot (DIS-9).
# Reversible fallback (assumption A-04): set false to drop HEIC entirely.
HEIC_ENABLED=true

# Test/dev override for the session temp root (default /tmp/coa_profiler_sessions).
# COA_PROFILER_TMP_DIR=/tmp/coa_profiler_sessions

# Required for production Compose builds. Use a release-unique immutable ID
# (tag plus commit is recommended); never reuse it for different static bytes.
COA_PROFILER_VERSION=
